  "cards": [
    {
      "dot": "cyan",
      "title": "接入层",
      "items": [
        "vLLM 以 KVConnector 接口接入,LMCacheMPConnector 同时承担 scheduler 与 worker 角色",
        "Scheduler Adapter 负责前缀 lookup 与命中调度,Worker Adapter 负责 KV retrieve / store",
        "两者通过 ZeroMQ RPC 访问 MP Server"
      ]
    },
    {
      "dot": "emerald",
      "title": "L1 本地介质",
      "items": [
        "L1 后端是封闭集合:DRAM、Device-DAX、GDS",
        "由 create_l1_managers 按配置顺序构建,每个 L1 拥有独立驱逐控制器",
        "L1 命中时可直接拷贝到 vLLM paged KV"
      ]
    },
    {
      "dot": "violet",
      "title": "L2 外部介质",
      "items": [
        "L2 适配器通过注册表按类型发现,模块延迟导入",
        "内置文件系统、raw block、NIXL、Mooncake、HF3FS 等适配器",
        "L2 命中先经 Prefetch Controller 预取到 L1"
      ]
    },
    {
      "dot": "amber",
      "title": "控制面",
      "items": [
        "KeyDirectory 维护跨实例的 key → 放置(instance/tier/backend)视图,查找结果是需在属主侧校验的提示",
        "Eviction Controller 对 L1 与 L2 执行 LRU/ARC/IsolatedLRU 等淘汰",
        "Prefetch Controller 以 key group × chunk 网格锁定 L1、向各 L2 询问并回填"
      ]
    }
  ]
}
