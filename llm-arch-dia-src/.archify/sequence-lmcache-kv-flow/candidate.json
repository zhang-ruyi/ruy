  "cards": [
    {
      "dot": "emerald",
      "title": "命中判定",
      "items": [
        "get_num_new_matched_tokens 返回外部可加载 token 数,第二项表示是否异步加载",
        "hit>0 为 LMCache 命中,0 为未命中并交给 vLLM 重算",
        "LookupModule 先提交 prefetch,KeyDirectory 提供跨实例放置视图"
      ]
    },
    {
      "dot": "cyan",
      "title": "L1 / L2",
      "items": [
        "L1 为 DRAM、Device-DAX、GDS;命中可直接拷贝到 paged KV",
        "L2 为文件系统、raw block、NIXL、Mooncake、HF3FS 等外部适配器",
        "L2 命中经 Prefetch Controller 预取进 L1,再写入 paged buffer"
      ]
    },
    {
      "dot": "amber",
      "title": "异步加载与写回",
      "items": [
        "start_load_kv 提交异步 retrieve,与 forward 计算重叠",
        "update_state_after_alloc 登记异步加载的 block,状态进入 WAITING_FOR_LOAD",
        "wait_for_save 在 forward 退出前冲刷 store,新 KV 异步写回 L1/L2"
      ]
    }
  ]
