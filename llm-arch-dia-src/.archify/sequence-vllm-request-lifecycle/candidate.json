  "cards": [
    {
      "dot": "emerald",
      "title": "连续批处理",
      "items": [
        "每步 schedule 只按 token budget 分配计算量，不区分 prefill / decode 阶段",
        "waiting 请求在 running 容量与 token budget 允许时被准入",
        "prefill 与 decode 可以出现在同一个批次中"
      ]
    },
    {
      "dot": "cyan",
      "title": "前缀缓存与 KV 分配",
      "items": [
        "get_computed_blocks 复用已算前缀块，allocate_slots 分配剩余 KV",
        "block_table 把逻辑块映射到物理块，供注意力内核按块 gather",
        "输出阶段推进 num_computed_tokens，使下一步继续追赶目标长度"
      ]
    },
    {
      "dot": "rose",
      "title": "抢占与回收",
      "items": [
        "显存不足时 _preempt_request 释放块并把请求放回 waiting",
        "被抢占请求的 num_computed_tokens 归零，后续重新计算",
        "update_from_output 汇总 token、结束原因与 KV connector 结果"
      ]
    }
  ]
