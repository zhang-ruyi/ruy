  "cards": [
    {
      "dot": "cyan",
      "title": "分层职责",
      "items": [
        "OpenAI API 与 LLMEngine 负责请求接入、输出处理与流式返回",
        "EngineCore 每步依次调用 schedule、execute_model 与 update_from_output",
        "GPUWorker 持有 GPUModelRunner，并落到具体注意力后端"
      ]
    },
    {
      "dot": "emerald",
      "title": "连续批处理",
      "items": [
        "Scheduler 不区分 prefill / decode 阶段，只比较已算 token 与目标 token",
        "每步在 token budget 内混合 waiting 准入与 running 追加",
        "update_from_output 推进 num_computed_tokens，并决定结束或抢占"
      ]
    },
    {
      "dot": "orange",
      "title": "KV 复用与旁路",
      "items": [
        "KVCacheManager 通过 KVCacheCoordinator 查找前缀命中，再在 BlockPool 分配物理块",
        "KV Connector 走旁路：调度侧匹配远端 KV，worker 侧执行保存与加载",
        "LMCache 与 NIXL 是同一连接器抽象下的具体实现"
      ]
    }
  ]
